# Production site URL, used for canonical URLs, JSON-LD @id values and OG tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact form delivery (app/api/contact). Left unset intentionally — see
# the Phase 5 report for provider options. Setting this alone does nothing;
# app/api/contact/route.ts's sendContactNotification() also needs the
# actual provider call filled in once one is chosen.
CONTACT_FORM_PROVIDER_KEY=

# Newsletter subscription delivery (app/api/newsletter). Same situation —
# see the Phase 5 report for provider options before setting this.
NEWSLETTER_PROVIDER_KEY=
