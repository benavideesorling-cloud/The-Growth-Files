# Production site URL, used for canonical URLs, JSON-LD @id values and OG tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public — Google Tag Manager container ID (starts with "GTM-"), from the
# GTM dashboard's container settings. Read in app/layout.tsx. Blank/unset
# means GTM simply doesn't render — no build error, no broken snippet.
# GA4 is configured inside this GTM container, not loaded separately here.
NEXT_PUBLIC_GTM_ID=

# --- Resend (Contact form + Newsletter) ---
# Server-only — never referenced from client components. Powers both
# app/api/contact/route.ts (email send) and app/api/newsletter/route.ts
# (audience/segment subscription). See the Phase 5 follow-up report for the
# exact dashboard setup steps.

# API key from https://resend.com/api-keys.
RESEND_API_KEY=

# Sender identity for contact-form notification emails. Using the default
# onboarding@resend.dev sandbox address only delivers to the Resend
# account's own verified email — for anyone else to receive mail reliably,
# verify a domain in the Resend dashboard and set this to an address on it,
# e.g. "The Growth Files <hello@thegrowthfiles.com>".
RESEND_FROM_EMAIL="The Growth Files <onboarding@resend.dev>"

# Where contact-form submissions are emailed. Optional — defaults to the
# public contact email already centralized in lib/config/site.ts.
CONTACT_TO_EMAIL=

# The Audience (Segment) ID newsletter subscribers are added to — copy this
# from the Resend dashboard's Audiences/Segments section.
RESEND_AUDIENCE_ID=

# --- Sanity (blog posts, case studies, authors, categories) ---
# Public, safe to expose client-side — these only identify which dataset to
# read, they don't grant write access. Project ID vw55vecs / dataset
# production are this project's real values, already provisioned.
NEXT_PUBLIC_SANITY_PROJECT_ID=vw55vecs
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-01-01

# Server-only. Required for Studio preview/draft mode
# (app/api/draft-mode/enable) — a token with at least Viewer access,
# generated from the Sanity dashboard (Manage → API → Tokens). Never
# exposed client-side; not needed for the published site to render.
SANITY_API_READ_TOKEN=

# Server-only, used exclusively by the one-off migration script — never
# read by the running app. A token with Editor/Write access. Do not set
# this in any deployed environment; run the migration locally and remove
# it from .env.local afterward.
SANITY_API_WRITE_TOKEN=
