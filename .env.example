# Production site URL, used for canonical URLs, JSON-LD @id values and OG tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Resend (Contact form + Newsletter) ---
# Server-only — never referenced from client components. Powers both
# app/api/contact/route.ts (email send) and app/api/newsletter/route.ts
# (audience/segment subscription). See the Phase 5 follow-up report for the
# exact dashboard setup steps.

# API key from https://resend.com/api-keys.
RESEND_API_KEY=

# Sender identity for contact-form notification emails. Using the default
# onboarding@resend.dev sandbox address only delivers to the Resend
# account's own verified email — for anyone else to receive mail reliably,
# verify a domain in the Resend dashboard and set this to an address on it,
# e.g. "The Growth Files <hello@thegrowthfiles.com>".
RESEND_FROM_EMAIL="The Growth Files <onboarding@resend.dev>"

# Where contact-form submissions are emailed. Optional — defaults to the
# public contact email already centralized in lib/config/site.ts.
CONTACT_TO_EMAIL=

# The Audience (Segment) ID newsletter subscribers are added to — copy this
# from the Resend dashboard's Audiences/Segments section.
RESEND_AUDIENCE_ID=
